# Copy this file to .env.local and fill in what you need. .env.local is git-ignored.

# Binance API key with "Enable Reading" ONLY (no trading, futures or withdrawal permissions). Optional in Phase 1.
BINANCE_KEY=
# Secret for the read-only Binance key above. Never commit or share it.
BINANCE_SECRET=
# Address the server listens on. Empty = 127.0.0.1 (this computer only); any other value requires APP_PASSWORD.
HOST=
# Port the server listens on. Empty = 8787.
PORT=
# Password for LAN access (e.g. from your phone). Required when HOST is not 127.0.0.1.
APP_PASSWORD=
# Path of the SQLite database file. Empty = data/sim.sqlite.
DB_PATH=

# Binance addresses, for testing against a relay or a fake exchange. Leave them empty for live Binance.
# Each is a base address (scheme, host, optional port and path prefix) with no query; the server appends Binance's paths.
# Spot REST (http/https). Empty = https://api.binance.com
BINANCE_SPOT_REST_URL=
# USDⓈ-M futures REST (http/https), the signed leverage-bracket call included. Empty = https://fapi.binance.com
BINANCE_FUTURES_REST_URL=
# Binance web API (http/https), for the public leverage-bracket fallback. Empty = https://www.binance.com
BINANCE_WEB_URL=
# Spot WebSocket streams (ws/wss); /stream and /ws are appended. Empty = wss://stream.binance.com:9443
BINANCE_SPOT_WS_URL=
# USDⓈ-M futures WebSocket streams (ws/wss); /public/... and /market/... are appended. Empty = wss://fstream.binance.com
BINANCE_FUTURES_WS_URL=
